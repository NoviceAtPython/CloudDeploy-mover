# CloudDeploy attributes file. Two concerns live here:
#
# 1. Line-ending normalization (text eol=lf) so a Windows clone does not
#    accidentally commit CRLF on shell / Python / Markdown files.
# 2. GitHub Linguist overrides (v3 only) so language stats reflect the
#    Go orchestrator instead of being dominated by the v2 Bash monolith.
#
# Linguist docs: https://github.com/github-linguist/linguist/blob/main/docs/overrides.md

# ---- line endings (kept from v2 baseline) ----
/.gitattributes text eol=lf
*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.service text eol=lf
*.conf  text eol=lf
*.ini   text eol=lf
*.patch text eol=lf

# v3 additions:
*.go     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.tmpl   text eol=lf
go.mod   text eol=lf
go.sum   text eol=lf
Makefile text eol=lf

# ---- GitHub Linguist overrides (v3 presentation) ----
#
# v3 is a Go orchestrator with a small Bash bootstrap. The v2 monolith
# stays on disk for fallback and bisect but should NOT count toward
# language stats. Stack three signals so Linguist actually obeys:
#
#   linguist-vendored      - mark as third-party / not part of the
#                            primary codebase. Excluded from stats.
#   linguist-generated     - mark as generated. Excluded from stats
#                            and from diff/blame views.
#   linguist-detectable=false - prevent Linguist from sniffing the
#                            file at all (last-resort opt-out).
#
# Together these three remove the file from the pie. Linguist will
# cache the result for a while; pushing this is the explicit signal.

CloudDeploy-wayland.sh              linguist-vendored linguist-generated linguist-detectable=false
CloudDeploy.ps1                     linguist-vendored linguist-generated linguist-detectable=false
clouddeploy-run-rootless-systemd.sh linguist-vendored linguist-generated linguist-detectable=false
main.py                             linguist-vendored linguist-detectable=false
*.ps1                               linguist-vendored linguist-detectable=false

# Anything we eventually move under legacy/ also does not count.
legacy/**   linguist-vendored linguist-detectable=false

# Existing v2 helper scripts/patches: data, not active code.
scripts/**  linguist-vendored linguist-detectable=false
patches/**  linguist-vendored linguist-detectable=false

# Future third-party submodule trees (Sunshine fork, KWin source, etc.).
# Harmless until they exist; prevents future drift in stats.
third-party/** linguist-vendored linguist-detectable=false

# v3 entrypoint: small Bash bootstrap is intentional and should stay visible.
bootstrap.sh   linguist-language=Shell

# v3 source surface: be explicit so YAML configs are recognised and the
# systemd template files (.tmpl) are linguist-detectable as Go templates.
*.go              linguist-language=Go
config/**/*.yaml  linguist-language=YAML
templates/**/*.tmpl linguist-detectable=true
templates/**/*.tmpl linguist-language=Go

# Documentation: detectable but flagged as documentation so it doesn't
# skew language stats.
docs/**  linguist-documentation
*.md     linguist-documentation
