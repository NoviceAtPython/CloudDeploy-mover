# CloudDeploy attributes file. Two concerns live here:
#
# 1. Line-ending normalization (text eol=lf) so a Windows clone does not
#    accidentally commit CRLF on shell / Python / Markdown files.
# 2. GitHub Linguist overrides (v3 only) so language stats reflect the
#    Go orchestrator instead of being dominated by the v2 Bash monolith.
#
# Linguist docs: https://github.com/github-linguist/linguist/blob/main/docs/overrides.md

# ---- line endings (kept from v2 baseline) ----
/.gitattributes text eol=lf
*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.service text eol=lf
*.conf  text eol=lf
*.ini   text eol=lf
*.patch text eol=lf

# v3 additions:
*.go     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.tmpl   text eol=lf
go.mod   text eol=lf
go.sum   text eol=lf
Makefile text eol=lf

# ---- GitHub Linguist overrides (v3 presentation) ----
#
# The v2 monolith is on disk for fallback and bisect, not as the active
# codebase. Mark it vendored so it stops dominating the language pie:

CloudDeploy-wayland.sh              linguist-vendored
CloudDeploy.ps1                     linguist-vendored
clouddeploy-run-rootless-systemd.sh linguist-vendored

# Anything we eventually move under legacy/ also does not count.
legacy/**   linguist-vendored

# Existing v2 helper scripts/patches: data, not active code.
scripts/**  linguist-vendored
patches/**  linguist-vendored

# Future third-party submodule trees (Sunshine fork, KWin source, etc.).
# Harmless until they exist; prevents future drift in stats.
third-party/** linguist-vendored

# v3 entrypoint: small Bash bootstrap is intentional and should stay visible.
bootstrap.sh   linguist-language=Shell

# v3 source surface: be explicit so YAML configs are recognised and the
# systemd template files (.tmpl) are linguist-detectable as Go templates.
*.go              linguist-language=Go
config/**/*.yaml  linguist-language=YAML
templates/**/*.tmpl linguist-detectable=true
templates/**/*.tmpl linguist-language=Go

# Documentation: detectable but flagged as documentation so it doesn't
# skew language stats.
docs/**  linguist-documentation
*.md     linguist-documentation
